# Copy to .env.public-demo only after the Pages URL and stable named-tunnel hostname are known.
# Set a private 10-64 character token before starting. Leaving this blank fails closed.
# This demo token is permitted only with PUBLIC_DEMO_MODE=1 and PAYMENT_MODE=demo.
PUBLIC_DEMO_ORIGIN=https://your-project.pages.dev
PUBLIC_DEMO_ACCESS_TOKEN=
BUYER_ALLOWED_HOSTS=127.0.0.1,localhost,::1,origin.your-domain.example
PUBLIC_DEMO_MAX_DELEGATIONS_PER_HOUR=20
PUBLIC_DEMO_MAX_REQUEST_CHARS=1000
PUBLIC_DEMO_MAX_MUTATIONS_PER_MINUTE=30
