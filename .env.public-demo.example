# Copy to .env.public-demo only after the stable Worker URL and current Quick Tunnel URL are known.
# This low-entropy access token is permitted only with PUBLIC_DEMO_MODE=1 and PAYMENT_MODE=demo.
PUBLIC_DEMO_ORIGIN=https://hirebit-demo.example-account.workers.dev
PUBLIC_DEMO_ACCESS_TOKEN=replace-with-demo-token
BUYER_ALLOWED_HOSTS=127.0.0.1,localhost,::1,replace-me.trycloudflare.com
PUBLIC_DEMO_MAX_DELEGATIONS_PER_HOUR=20
PUBLIC_DEMO_MAX_REQUEST_CHARS=1000
PUBLIC_DEMO_MAX_MUTATIONS_PER_MINUTE=30
