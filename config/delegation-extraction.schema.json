{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "objectiveFamily",
    "objectiveConfidence",
    "budgetSats",
    "budgetType",
    "deadlineMinutes",
    "deadlineType",
    "decisionPriorities",
    "authorizationMode",
    "autoAuthorizationExplicit",
    "subject",
    "brief",
    "assumptions",
    "ambiguities",
    "clarificationQuestions",
    "evidence"
  ],
  "properties": {
    "objective": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "objectiveFamily": {
      "type": ["string", "null"],
      "enum": ["conversion", "direct_response", "comparison", "social_proof", "product_education", "objection_handling", "brand_awareness", "engagement", "other", null]
    },
    "objectiveConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "budgetSats": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "budgetType": {
      "type": ["string", "null"],
      "enum": ["hard_limit", "target", null]
    },
    "deadlineMinutes": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "deadlineType": {
      "type": ["string", "null"],
      "enum": ["hard", "preferred", null]
    },
    "decisionPriorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "quality", "cost", "speed"],
      "properties": {
        "objective": { "type": "number", "minimum": 0, "maximum": 1 },
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "speed": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "authorizationMode": {
      "type": "string",
      "enum": ["advisory_only", "confirm_before_purchase", "auto_within_budget", "unspecified"]
    },
    "autoAuthorizationExplicit": {
      "type": "boolean"
    },
    "subject": {
      "type": ["string", "null"],
      "maxLength": 300
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productName",
        "description",
        "referenceUrl",
        "evidenceUrl",
        "items",
        "languages",
        "aspectRatios",
        "hookVariants",
        "visualMode",
        "voiceRequirements"
      ],
      "properties": {
        "productName": { "type": ["string", "null"], "maxLength": 160 },
        "description": { "type": ["string", "null"], "maxLength": 1200 },
        "referenceUrl": { "type": ["string", "null"], "maxLength": 2048 },
        "evidenceUrl": { "type": ["string", "null"], "maxLength": 2048 },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 200 }
        },
        "languages": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 20 }
        },
        "aspectRatios": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "maxLength": 12 }
        },
        "hookVariants": {
          "type": ["integer", "null"],
          "enum": [1, 3, 5, null]
        },
        "visualMode": {
          "type": ["string", "null"],
          "enum": ["package_default", "product_only", null]
        },
        "voiceRequirements": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "style", "pace", "accent"],
            "properties": {
              "role": { "type": "string", "enum": ["narrator", "host_a", "host_b"] },
              "style": { "type": "string", "enum": ["neutral", "warm", "energetic", "calm"] },
              "pace": { "type": "string", "enum": ["slow", "normal", "fast"] },
              "accent": { "type": ["string", "null"], "maxLength": 80 }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 180 }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "description"],
        "properties": {
          "field": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 180 }
        }
      }
    },
    "clarificationQuestions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "question", "reason", "importance", "impact"],
        "properties": {
          "field": { "type": "string", "maxLength": 80 },
          "question": { "type": "string", "maxLength": 180 },
          "reason": { "type": "string", "maxLength": 180 },
          "importance": { "type": "string", "enum": ["required", "optional"] },
          "impact": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "excerpt"],
        "properties": {
          "field": { "type": "string", "maxLength": 80 },
          "excerpt": { "type": "string", "maxLength": 120 }
        }
      }
    }
  }
}
