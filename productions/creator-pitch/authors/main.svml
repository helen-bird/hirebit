<?svml using="@hypit/markup@1"?>
<svml>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="typo" from="@hypit/typography-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="look" source="../../look.svs"/>

  <asset:Image id="presenter" src="../../shared-assets/arduino-uno-r4-wifi/fictional-creator-presenter.png"/>
  <asset:Image id="product" src="../../shared-assets/arduino-uno-r4-wifi/product.jpg"/>
  <asset:Audio id="narration" src="../assets/narration.wav"/>

  <space:Canvas id="canvas" width="540" height="960"/>
  <program:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="program" clock={clock} end="16s"/>
  <space:Frame id="full" within={canvas} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="product-card" within={canvas} left="50%" top="55%" right="94%" bottom="80%"/>
  <space:Frame id="eyebrow-frame" within={canvas} left="7%" top="6%" right="90%" bottom="12%"/>
  <space:Frame id="title-frame" within={canvas} left="7%" top="12%" right="92%" bottom="30%"/>
  <space:Frame id="feature-frame" within={canvas} left="7%" top="81%" right="93%" bottom="94%"/>
  <space:Extent id="presenter-size" width="941" height="1672"/>
  <space:Extent id="product-size" width="1280" height="972"/>

  <media-track:Track id="visuals" timeline={program.timeline} canvas={canvas}>
    <media-track:Item id="presenter-shot" image={presenter} extent={presenter-size}
      during="program" frame={full} appearance={look.media.backdrop} motion={look.motion.backdrop}/>
    <media-track:Item id="product-shot" image={product} extent={product-size}
      start="7.2s" end="15.5s" frame={product-card} appearance={look.media.product} motion={look.motion.card}/>
  </media-track:Track>

  <fonts:Stack id="font" family="inter" weight="700" style="normal" emoji="color">
    <fonts:Fallback family="noto-sans-sc" weight="700" style="normal"/>
  </fonts:Stack>
  <typo:Style id="eyebrow-style" recipe={look.text.eyebrow} font={font}><typo:Fill color="#8ff1e8"/></typo:Style>
  <typo:Style id="title-style" recipe={look.text.title} font={font}>
    <typo:Fill color="#ffffff"/><typo:Shadow color="#001718aa" x="0" y="5" blur="14"/>
  </typo:Style>
  <typo:Style id="card-style" recipe={look.text.caption} font={font}>
    <typo:Fill color="#ffffff"/><typo:Box target="line" continuity="isolated" color="#063f43dd" padding="9 14" radius="12"/>
  </typo:Style>
  <typo:Motion id="arrive"><typo:ItemKeyframe at="0" y="24" opacity="0"/><typo:ItemKeyframe at="12" y="0" opacity="1"/></typo:Motion>
  <typo:Track id="copy" timeline={program.timeline}>
    <typo:Area id="eyebrow" placement={eyebrow-frame} style={eyebrow-style} motion={arrive} start="0.3s" end="5.8s">CREATOR PITCH · EN-US</typo:Area>
    <typo:Area id="headline" placement={title-frame} style={title-style} motion={arrive} start="0.5s" end="6.8s">Your next idea starts on one board.</typo:Area>
    <typo:Area id="feature-one" placement={feature-frame} style={card-style} motion={arrive} start="6.8s" end="9.7s">32-bit RA4M1</typo:Area>
    <typo:Area id="feature-two" placement={feature-frame} style={card-style} motion={arrive} start="9.7s" end="12.5s">Wi-Fi + Bluetooth</typo:Area>
    <typo:Area id="feature-three" placement={feature-frame} style={card-style} motion={arrive} start="12.5s" end="16s">Built-in 12×8 LED matrix</typo:Area>
  </typo:Track>

  <pipeline:Normalize id="narration-media" source={narration} clock={clock}
    video="none" audio="default" span-authority="audio"/>
  <audio:Track id="voice" timeline={program.timeline}>
    <audio:Item id="creator-voice" source={narration-media.media} during="program"
      playback="once" gain="1" fade-in="2f" fade-out="6f"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={look.film.vertical}>
    <film:Track source={visuals.visual}/><film:Track source={copy.track}/><film:Track source={voice.audio}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
