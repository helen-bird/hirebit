<?svml using="@hypit/markup@1"?>
<svml>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="typo" from="@hypit/typography-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="look" source="../../look.svs"/>

  <asset:Image id="product" src="../../shared-assets/arduino-uno-r4-wifi/product.jpg"/>
  <asset:Audio id="narration" src="../assets/narration.wav"/>

  <space:Canvas id="canvas" width="540" height="960"/>
  <program:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="program" clock={clock} end="25s"/>
  <space:Frame id="full" within={canvas} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="product-card" within={canvas} left="7%" top="22%" right="93%" bottom="63%"/>
  <space:Frame id="eyebrow-frame" within={canvas} left="7%" top="5%" right="93%" bottom="11%"/>
  <space:Frame id="title-frame" within={canvas} left="7%" top="10%" right="93%" bottom="22%"/>
  <space:Frame id="proof-frame" within={canvas} left="7%" top="67%" right="93%" bottom="91%"/>
  <space:Extent id="product-size" width="1280" height="972"/>

  <media-track:Track id="visuals" timeline={program.timeline} canvas={canvas}>
    <media-track:Item id="product-shot" image={product} extent={product-size}
      during="program" frame={product-card} appearance={look.media.product} motion={look.motion.card}/>
  </media-track:Track>

  <fonts:Stack id="font" family="inter" weight="700" style="normal" emoji="color">
    <fonts:Fallback family="noto-sans-sc" weight="700" style="normal"/>
  </fonts:Stack>
  <typo:Style id="eyebrow-style" recipe={look.text.eyebrow} font={font}><typo:Fill color="#8ff1e8"/></typo:Style>
  <typo:Style id="title-style" recipe={look.text.title} font={font}><typo:Fill color="#ffffff"/></typo:Style>
  <typo:Style id="proof-style" recipe={look.text.card} font={font}>
    <typo:Fill color="#ffffff"/><typo:Box target="line" continuity="isolated" color="#0c4c50" padding="10 16" radius="12"/>
  </typo:Style>
  <typo:Motion id="arrive"><typo:ItemKeyframe at="0" x="-28" opacity="0"/><typo:ItemKeyframe at="10" x="0" opacity="1"/></typo:Motion>
  <typo:Track id="copy" timeline={program.timeline}>
    <typo:Area id="eyebrow" placement={eyebrow-frame} style={eyebrow-style} start="0.2s" end="25s">PROOF DEMO · 简体中文</typo:Area>
    <typo:Area id="headline" placement={title-frame} style={title-style} motion={arrive} start="0.3s" end="6s">一块板，三个可验证升级。</typo:Area>
    <typo:Area id="proof-one" placement={proof-frame} style={proof-style} motion={arrive} start="5.5s" end="11.5s">01 · RA4M1 32 位 MCU</typo:Area>
    <typo:Area id="proof-two" placement={proof-frame} style={proof-style} motion={arrive} start="11.5s" end="18s">02 · ESP32-S3 无线连接</typo:Area>
    <typo:Area id="proof-three" placement={proof-frame} style={proof-style} motion={arrive} start="18s" end="25s">03 · 板载 12×8 LED 点阵</typo:Area>
  </typo:Track>

  <pipeline:Normalize id="narration-media" source={narration} clock={clock}
    video="none" audio="default" span-authority="audio"/>
  <audio:Track id="voice" timeline={program.timeline}>
    <audio:Item id="proof-voice" source={narration-media.media} during="program"
      playback="once" gain="1" fade-in="2f" fade-out="6f"/>
  </audio:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={look.film.vertical}>
    <film:Track source={visuals.visual}/><film:Track source={copy.track}/><film:Track source={voice.audio}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
