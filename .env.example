# Local listeners. Keep both services on loopback unless a reviewed TLS proxy is added.
HOST=127.0.0.1
PORT=8787
BUYER_HOST=127.0.0.1
BUYER_PORT=8788

# GoBTC Pay mainnet configuration. Secrets should stay in the documented owner-only files or Keychain.
# Keep `gobtcpay` for real mainnet. Use `demo` only for the explicitly labelled no-Bitcoin preview.
PAYMENT_MODE=gobtcpay
GOBTCPAY_BASE_URL=https://api.gobtcpay.com/public/api/v1.2
GOBTCPAY_BUYER_MULTISIG_ADDRESS=
GOBTCPAY_PAYER_PUBLIC_KEY=

# Direct DeepSeek integration requested for this project. Prefer the shared protected Keychain entry.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Google Cloud TTS uses Application Default Credentials, not a stored API key.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_CLI_PATH=/absolute/path/to/google-cloud-sdk/bin/gcloud
# CLOUDSDK_PYTHON=/absolute/path/to/a/supported/python3
SELLER_VOICE_PROVIDER=google-cloud-tts
GOOGLE_TTS_MAX_CHARACTERS_PER_ORDER=20000
# Set to 1 only after the selected Google Cloud terms/voice usage have been reviewed.
GOOGLE_TTS_COMMERCIAL_USE_APPROVED=0
# Set to 1 only after Google Veo terms and intended commercial use have been reviewed.
GOOGLE_VEO_ENABLED=0
GOOGLE_VEO_COMMERCIAL_USE_APPROVED=0
GOOGLE_VEO_LOCATION=us-central1
GOOGLE_VEO_MODEL=veo-3.1-lite-generate-001
# Rolling one-hour cap. Rejected or uncertain submissions count conservatively.
GOOGLE_VEO_MAX_GENERATIONS=20

# Paid workflows remain unavailable until every production has passed docs/PRODUCTION_ACCEPTANCE.md
# and the dedicated worker isolation has been verified on this machine.
HYPIT_WORKER_MODE=docker
HYPIT_WORKER_IMAGE=agentic-hypit-worker:local
# DOCKER_BIN=/absolute/path/to/docker
HYPIT_WORKER_ISOLATION_VERIFIED=0
SELLER_HYPIT_WORKFLOWS=config/hypit-workflows.json
SELLER_MAX_CONCURRENT_PRODUCTIONS=1

# Public deployment is a separate, opt-in Demo profile. Never combine it with real GoBTC payments.
# Copy .env.public-demo.example to .env.public-demo and use the public-demo:* commands.
